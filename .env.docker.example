# Salin ke .env di root proyek, lalu ganti semua nilai rahasia.
DB_NAME=bekal_db
DB_USER=bekal_app
DB_PASSWORD=ganti_dengan_password_database_yang_kuat
MYSQL_ROOT_PASSWORD=ganti_dengan_password_root_mysql_yang_kuat
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter

# Ganti localhost dengan domain/IP server sekolah bila sudah diketahui.
HTTP_PORT=80
CLIENT_URL=http://localhost
APP_URL=http://localhost

# Isi bila fitur email atau Cloudinary digunakan.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
